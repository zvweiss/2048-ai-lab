{
  "name": "2048-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/trainer",
    "packages/core"
  ],
  "scripts": {
    "core:build": "npm --workspace packages/core run build",

    "trainer:dev": "npm run core:build && npm --workspace apps/trainer run dev",
    "trainer:build": "npm --workspace apps/trainer run build",

    "trainer:train": "npm --workspace apps/trainer run train --",
    "trainer:train:valuenet": "npm --workspace apps/trainer run train:valuenet --",
    "trainer:eval": "npm --workspace apps/trainer run eval --",

    "ui:dev": "node scripts/run-ui-dev.mjs",
    "ui:build": "node scripts/run-ui-build.mjs",

    "format:check": "node scripts/format-check.mjs",

    "eval:random:500": "npm run trainer:eval -- --agent random --games 500",
    "eval:random:1000": "npm run trainer:eval -- --agent random --games 1000",
    
    "eval:expectimax:v001": "npm run trainer:eval -- --agent expectimax --games 200 --seed 1337 --depth 2 --p2 0.9 --out docs/baselines/expectimax-v001.json",
    "eval:expectimax:d3:g50": "npm run trainer:eval -- --agent expectimax --games 50 --seed 1337 --depth 3 --p2 0.9 --out docs/baselines/expectimax-d3-g50.json",
    
    "train:valuenet:smoke": "npm run trainer:train:valuenet -- --episodes 1 --seed 1337 --out artifacts/models/valuenet-v001/run-smoke",
    "eval:valuenet:smoke": "npm run trainer:eval -- --agent valuenet-v001 --games 10 --seed 1337 --model artifacts/models/valuenet-v001/run-smoke/model.json --out artifacts/eval/valuenet-smoke.json",
    "smoke:valuenet": "npm run train:valuenet:smoke && npm run eval:valuenet:smoke",
    
    "exp:valuenet:v001": "node scripts/run-experiment-valuenet-v001.mjs",
    "exp:valuenet:v001:test-check": "npm run exp:valuenet:v001 -- --run test-check --episodes 100 --games 10 --seed 1337",
    "exp:valuenet:v001:run-001": "npm run exp:valuenet:v001 -- --run run-001 --episodes 20000 --games 500 --seed 1337",
    "exp:valuenet:v001:run-002": "npm run exp:valuenet:v001 -- --run run-002 --episodes 20000 --games 500 --seed 1337",
    "exp:valuenet:v001:run-003": "npm run exp:valuenet:v001 -- --run run-003 --episodes 20000 --games 500 --seed 1337",
    "exp:valuenet:v001:run-004": "node scripts/run-experiment-valuenet-v001.mjs --run run-004 --episodes 5000 --games 100 --seed 1337",
    "exp:valuenet:v001:run-005": "node scripts/run-experiment-valuenet-v001.mjs --run run-005 --episodes 50000 --games 500 --seed 1337",
    "exp:valuenet:v001:run-006": "node scripts/run-experiment-valuenet-v001.mjs --run run-006 --episodes 50000 --games 500 --seed 2024",
    "exp:valuenet:v001:run-007": "node scripts/run-experiment-valuenet-v001.mjs --run run-007 --episodes 50000 --games 500 --seed 9001",

    "exp:valuenet:v001-future-ready": "future",
    "exp:valuenet:v001:run-004-eps-005": "node scripts/run-experiment-valuenet-v001.mjs --run run-004-eps-005 --episodes 50000 --games 500 --seed 1337 --epsilon 0.05",
    "exp:valuenet:v001:run-005-gamma-097": "node scripts/run-experiment-valuenet-v001.mjs --run run-005-gamma-097 --episodes 50000 --games 500 --seed 1337 --gamma 0.97",
    "exp:valuenet:v001:run-006-wide-net": "node scripts/run-experiment-valuenet-v001.mjs --run run-006-wide-net --episodes 50000 --games 500 --seed 1337 --hiddenSizes 256,256",

    "report:learning-curve": "node scripts/report-learning-curve.mjs",
    "report:learning-curve-run-001": "npm run report:learning-curve -- --run run-001",
    "report:learning-curve-run-002": "npm run report:learning-curve -- --run run-002",
    "report:learning-curve-run-003": "npm run report:learning-curve -- --run run-003",
    "report:learning-curve-run-004": "npm run report:learning-curve -- --run run-004",
    "report:learning-curve-run-005": "npm run report:learning-curve -- --run run-005",
    "report:learning-curve-run-006": "npm run report:learning-curve -- --run run-006",
    "report:learning-curve-run-007": "npm run report:learning-curve -- --run run-007",

    "report:learning-curve-future-ready": "future",
    "report:learning-curve-run-004-eps-005": "npm run report:learning-curve -- --run run-004-eps-005",
    "report:learning-curve-run-005-gamma-097": "npm run report:learning-curve -- --run run-005-gamma-097",
    "report:learning-curve-run-006-wide-net": "npm run report:learning-curve -- --run run-006-wide-net",

    "report:experiment-summary": "node scripts/report-experiment-summary.mjs",
    "report:experiment-summary:default": "node scripts/report-experiment-summary.mjs --runs run-005,run-006,run-007",
    "report:experiment-summary:all": "node scripts/report-experiment-summary.mjs --runs run-004,run-005,run-006,run-007",
    "report:experiment-summary:sorted": "node scripts/report-experiment-summary.mjs --runs run-005,run-006,run-007 --sortBy meanScore",

    "baseline:random": "npm run trainer:eval -- --agent random --games 500 --seed 1337 --out docs/baselines/random-v001.json",
    "baseline:expectimax:v001": "npm run trainer:eval -- --agent expectimax --games 200 --seed 1337 --depth 2 --p2 0.9 --out docs/baselines/expectimax-v001.json",
    "baseline:expectimax:d3": "npm run trainer:eval -- --agent expectimax --games 50 --seed 1337 --depth 3 --p2 0.9 --out docs/baselines/expectimax-d3-g50.json",
    "baseline:valuenet:v001": "node scripts/run-experiment-valuenet-v001.mjs --run baseline-v001 --episodes 20000 --games 500 --seed 1337",

    "baselines:rebuild": "npm run baseline:random && npm run baseline:expectimax:v001 && npm run baseline:expectimax:d3 && npm run baseline:valuenet:v001",

    "report:baselines": "node scripts/report-baselines.mjs"
  }
}
